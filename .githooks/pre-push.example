#!/usr/bin/env bash
# set -e: exit on error; set -o pipe-pipefail: fail pipeline on any error
set -euo pipefail

# Local mirror of the CI gas gate: fail fast if .gas-snapshot is out of sync.
# Generation itself is automated in CI (scheduled refresh job), so this hook
# only verifies. Set GAS_TOLERANCE to change the tolerated deviation (percent).
echo "[pre-push] Checking that .gas-snapshot is in sync…"
forge snapshot --check --tolerance "${GAS_TOLERANCE:-5}"
echo "[pre-push] .gas-snapshot in sync."
